{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flavor",
  "version": "0.1.0-beta.11",
  "identifier": "dev.lunarlabs.flavor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Flavor",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "freezePrototype": true,
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": false,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFMzA3N0FCQkJGNURFRjQKUldUMDN2VzdxM2N3TGtEbUhpa3M5bDVvZTJDa09xTSt2SGt4cHhtSFQvQkpzLzRZRk9SZHg3eTIK",
      "endpoints": [
        "https://cdn.tame.gg/flavor-desktop/latest.json"
      ]
    }
  }
}
