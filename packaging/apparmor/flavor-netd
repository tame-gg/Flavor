abi <abi/4.0>,

include <tunables/global>

profile flavor-netd /usr/libexec/flavor/flavor-netd flags=(attach_disconnected) {
  include <abstractions/base>
  include <abstractions/dbus-strict>

  capability net_admin,

  network unix seqpacket,
  network unix stream,
  network unix dgram,
  network netlink raw,

  /usr/libexec/flavor/flavor-netd mr,
  /dev/net/tun rw,
  @{PROC}/@{pid}/stat r,
  owner @{PROC}/@{pid}/cgroup r,
  owner @{PROC}/@{pid}/mountinfo r,
  /run/systemd/notify w,

  dbus (send) bus=system path=/org/freedesktop/PolicyKit1/Authority interface=org.freedesktop.PolicyKit1.Authority member=CheckAuthorization peer=(name=org.freedesktop.PolicyKit1),
  dbus (send) bus=system path=/org/freedesktop/resolve1 interface=org.freedesktop.resolve1.Manager member={SetLinkDNS,SetLinkDomains,SetLinkDefaultRoute,RevertLink} peer=(name=org.freedesktop.resolve1),
  dbus (send) bus=system path=/org/freedesktop/login1 interface=org.freedesktop.login1.Manager member={GetSessionByPID,GetUser} peer=(name=org.freedesktop.login1),
  dbus (send) bus=system path=/org/freedesktop/login1/{session,user}/** interface=org.freedesktop.DBus.Properties member=Get peer=(name=org.freedesktop.login1),
}
