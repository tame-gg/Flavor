[Unit]
Description=Lattice synthetic networking helper
Requires=lattice-netd.socket
After=lattice-netd.socket dbus.service

[Service]
Type=notify
ExecStart=/usr/lib/lattice/lattice-netd
User=root
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
RestrictAddressFamilies=AF_UNIX AF_NETLINK
IPAddressDeny=any
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
UMask=0077
RuntimeDirectory=lattice-netd
RuntimeDirectoryMode=0700

[Install]
Also=lattice-netd.socket
